# ---- patient data and anything derived from it -------------------------------
# PRIVATE/ is where prepared hospital pairs and ID_MAP_DO_NOT_EXPORT.csv land.
# It must never be tracked, not even when it only holds rehearsal symlinks.
PRIVATE/
*_thin.npy
*_thick.npy
*_lung.npy
*_base.npy
ID_MAP_DO_NOT_EXPORT.csv

# ---- bulk data ---------------------------------------------------------------
DATA/
*.nii
*.nii.gz
*.dcm

# ---- checkpoints and run logs (rebuildable; hundreds of MB) -------------------
runs/
*.pt
!.gitkeep

# ---- internal material that must not be redistributed ------------------------
*.pptx
*.ppt

# ---- idea-generation working files -------------------------------------------
# Literature-retrieval dumps and idea cards from the ideation phase. They are working
# notes, not part of the method or its evidence, and the conclusions that survived are
# in STAGE1_执行报告.md.
ideaspark_run/

# ---- scratch -----------------------------------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/

# the shipped public weights are small enough to track
!public.pt
!public_flow.pt
!public_8mm.pt
!public_realft.pt
!public_forward_op.pt
# the zero-shot backbone: stage 7b is the primary on-site result and cannot run
# without it, so it belongs in the clone rather than in a side channel
!public_cthnet.pt
baselines/i3net/
RECON/
reader_manifest_DO_NOT_EXPORT.csv
READER/
